# ── Discord ───────────────────────────────────────
BOT_TOKEN=
CLIENT_ID=
GUILD_ID=

# ── HuggingFace ──────────────────────────────────
HF_TOKEN=              # write-scoped token from https://huggingface.co/settings/tokens
HF_ORG=                # optional: org name to upload under (leave blank for personal)

# ── RunPod (optional — only needed for provider=runpod) ──
# Get from https://runpod.io/console/user/settings → API Keys
# The provider also needs ~/.ssh/id_rsa{,.pub} — the public key is injected
# into each pod via env[PUBLIC_KEY] on create.
RUNPOD_API_KEY=

# ── Access Control ───────────────────────────────
ADMIN_IDS=             # comma-separated Discord user IDs

# ── Paths ────────────────────────────────────────
WORKSPACE_DIR=./tmp/workdir
EXLLAMAV3_DIR=./exllamav3    # path to cloned exllamav3 repo

# ── Runtime ──────────────────────────────────────
NODE_ENV=development
CONCURRENT_JOBS=1
SHUTDOWN_TIMEOUT_MS=60000
PROCESS_KILL_GRACE_MS=5000
PYTHON_BIN=

# ── Retry / Timeout Policy ───────────────────────
HF_PREFLIGHT_TIMEOUT_MS=30000
HF_DOWNLOAD_TIMEOUT_MS=3600000
HF_UPLOAD_TIMEOUT_MS=3600000
QUANTIZE_TIMEOUT_MS=43200000
HF_RETRY_MAX_ATTEMPTS=3
HF_RETRY_BASE_DELAY_MS=1500
HF_RETRY_MAX_DELAY_MS=20000
HF_RETRY_JITTER_PCT=25

# ── Cache Policy ─────────────────────────────────
MODEL_CACHE_ENABLED=true
MODEL_CACHE_TTL_HOURS=72
MODEL_CACHE_MAX_ENTRIES=5
MODEL_CACHE_MAX_BYTES=214748364800
MODEL_CACHE_PRUNE_ON_STARTUP=true
MODEL_CACHE_VALIDATE_ON_RESTORE=true

# ── Logging / Security ───────────────────────────
LOG_REDACTION_ENABLED=true
LOG_INCLUDE_STACKS=true
PUBLIC_ERROR_REDACTION_ENABLED=true

# ── Quantization Defaults ────────────────────────
HEAD_BITS=6
# EXL3 trellis codebook for new quants: mul1, mcg or 3inst. /quant can override
# it per job. mcg is ExLlamaV3's own default and what every quant published
# before this setting existed used.
CODEBOOK=mul1

# ── Python Backend API (Discord bot) ────────────
# src/services/api-client.js uses this URL and defaults to http://localhost:8000
BLOCKQUANT_API_URL=http://localhost:8000

# ── Chat module (optional, removable — src/chat/) ─
# Kimi-powered chat. Off unless CHAT_ENABLED=true AND KIMI_API_KEY is set.
CHAT_ENABLED=false
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.ai/v1
KIMI_MODEL=kimi-k2.7-code
# Optional: pen chat into specific channel IDs (comma-separated; empty = reply
# wherever the bot is @mentioned). Optional custom system prompt.
CHAT_CHANNELS=
CHAT_SYSTEM_PROMPT=
CHAT_MAX_TOKENS=1024

# ── CatBench (/catbench) ─────────────────────────
# Runs without admin approval, so these are the guard rails. Max weight size in
# GB (a single H100 is the ceiling: ~64 GB is ~32B params at bf16), and how long
# a non-admin waits between runs.
CATBENCH_MAX_GB=64
CATBENCH_COOLDOWN_MS=1800000
# Where finished runs are kept, so a model is only ever benched once. An HF
# dataset repo that HF_TOKEN can write to; the bot pushes the manifest, both
# rasters and both sources there and reads it back before renting anything.
# Leave empty and results stay in data/catbench on this box only.
CATBENCH_DATASET=Honkware/catbench-results

# Contributing runs back to the upstream gallery (`/catbench contribute:true`,
# admin only). Off unless GITHUB_TOKEN and CATBENCH_FORK are both set.
#
# GITHUB_TOKEN needs `public_repo` on a fork of CATBENCH_UPSTREAM that you own;
# it never writes to upstream itself, only to the fork and the pull request.
# Contributions batch onto CATBENCH_BRANCH so the maintainer gets one thread
# that grows rather than a pull request per bench.
GITHUB_TOKEN=
CATBENCH_UPSTREAM=Katehuuh/Katehuuh.github.io
CATBENCH_FORK=Honkware/Katehuuh.github.io
# `catbench` is the sensible name; this box says catbench-qwopus because that is
# the branch the first, hand-made pull request already sits on, and joining it
# beats opening a second one.
CATBENCH_BRANCH=catbench-qwopus
CATBENCH_ASSET_DIR=demos/CatBench/assets
