# BlockQuant pre-baked RunPod image.
#
# Bakes every gotcha we discovered the hard way so that a RunPod pod is
# "quant-ready" the instant it boots — no apt-get, no pip during the run.
#
# One image for every architecture. exllamav3 1.4.9 covers every registered
# archs from a single build: the linear-attention family (qwen3_5, qwen3_next,
# nemotronh) needs flash-linear-attention, which is installed here, and nothing
# else needs a separate bake. The old three-image split (stable 0.0.38 +
# qwen35 0.0.43 + a master image for LFM2) is gone.
#
# **Python 3.12** is load-bearing. fla's triton kernels trip triton bug #5224
# (multi-decorator @triton.jit -> inspect.getsource returns only the decorators
# -> `import fla` AttributeError) on Python 3.11 but not on 3.12. So
# ubuntu24.04 (native py3.12), torch 2.8/cu129, triton at its native 3.4.0.
#
# flash-attn is NOT installed and is no longer needed: exllamav3 1.4.9 ships
# Triton attention kernels that lead the dispatch order and handle sliding
# window, so Gemma3/Gemma4/Mellum no longer depend on a prebuilt FA2 wheel.
#
# Built and pushed by .github/workflows/build-runpod-image.yml.

# ---- Base (ubuntu24.04 -> Python 3.12) ------------------------------------
# devel because exllamav3's C++/CUDA extension JIT-compiles on the pod (nvcc +
# ninja), cached at /root/.cache/torch_extensions.
FROM nvidia/cuda:12.9.1-cudnn-devel-ubuntu24.04

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1

RUN apt-get update && apt-get install -y --no-install-recommends \
        python3.12 python3.12-dev python3-pip \
        git wget ca-certificates \
        ninja-build build-essential \
        openssh-server \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /var/run/sshd \
    && update-alternatives --install /usr/bin/python python /usr/bin/python3.12 1 \
    && update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.12 1 \
    && rm -f /usr/lib/python3.12/EXTERNALLY-MANAGED

# ---- torch 2.8 / cu129 (pip auto-selects the cp312 wheel) ------------------
RUN python -m pip install \
        "torch==2.8.0" \
        --index-url https://download.pytorch.org/whl/cu129

# ---- Python deps ----------------------------------------------------------
# hf_transfer gives parallel, Rust-backed weight downloads (the 70GB+ pull is
# the longest part of a run); remote/quant.py turns it on when it is present.
RUN python -m pip install \
        "hf_transfer>=0.1.6" \
        "huggingface-hub>=0.21" \
        "transformers>=4.56.0,<5" \
        "accelerate>=0.34" \
        "tokenizers>=0.21.1" \
        "safetensors>=0.4" \
        "datasets>=2.0" \
        "numpy>=2.1.0" \
        "Pillow>=10.0" \
        "marisa-trie>=1.2" \
        "pydantic==2.11.0" \
        "rich>=13.0" \
        "tqdm" \
        "psutil" \
        "sentencepiece" \
        "pyyaml" \
        "typing_extensions" \
        "einops"

# ---- ExLlamaV3 ------------------------------------------------------------
# Pinned to a git ref, not a PyPI release, so the image carries architectures
# merged upstream but not yet released. --no-deps stops pip resolving torch and
# fla again; both are installed explicitly here.
# The CUDA ext is built here, not on the pod. _get_cuda_arch_flags reads
# TORCH_CUDA_ARCH_LIST before it tries to detect a device, so naming the arches
# is what lets a GPU-less CI builder compile -- the IndexError that pushed this
# to a JIT build was the fallback path, not a hard limit. Building once in CI
# takes the compile off every pod boot, where it was billed GPU time.
#
# Arches cover everything the GPU selector can pick at >=24 GB: A100 (8.0),
# A40/A5000/3090 (8.6), L40S/4090/6000-Ada (8.9), H100 (9.0), 5090 and
# RTX PRO 6000 Blackwell (12.0). +PTX leaves a JIT path for anything newer.
ENV TORCH_CUDA_ARCH_LIST="8.0;8.6;8.9;9.0;12.0+PTX"
ARG MAX_JOBS=2
ENV MAX_JOBS=${MAX_JOBS}
# Bump EXLLAMAV3_REF behind an end-to-end validation pass. The controller's
# health check enforces a minimum reported version (_MIN_EXLLAMAV3 in
# providers/runpod/provider.py); this ref reports 1.4.9.
#
# v1.4.9. Pinned to the tag's commit rather than the tag name, since a tag can
# be moved.
#
# 1.4.2 -> 1.4.9 changes what we ship for vision models. --vision_bits used to
# default to 16 (tower copied unquantized) and now defaults to auto: a tower the
# arch declares validated goes to 6 bpw, every other tower stays at 16. Qwen3-VL,
# Gemma4, GLM4V, Step3, DeepSeek-V4-Vision and MuseGlimmer are validated as of
# this ref, so the same /quant request now produces a different artifact than it
# did before the bump. The vision option on the command is what makes that
# choice visible and reversible.
ARG EXLLAMAV3_REF=5be886578ec80324c2c715269387be2058724b6e
RUN python -m pip install --no-cache-dir --no-deps \
        "exllamav3 @ git+https://github.com/turboderp-org/exllamav3@${EXLLAMAV3_REF}"

# ---- flash-linear-attention (linear-attention archs) ----------------------
# exllamav3 lists it in install_requires; the gated-delta-net path uses its
# chunked kernel for prefill and falls back to a much slower built-in recurrent
# kernel without it, and nemotronh/mamba2 import it outright.
RUN python -m pip install --no-cache-dir "flash-linear-attention>=0.5.0"

# ---- Bundled calibration corpus ------------------------------------------
# exllamav3's packaging still omits conversion/standard_cal_data/*.utf8 (not in
# package_data, not in MANIFEST.in), which convert_model needs. Fetch it into
# the installed package.
COPY docker/fetch_cal_data.py /tmp/fetch_cal_data.py
RUN python /tmp/fetch_cal_data.py && rm /tmp/fetch_cal_data.py

# The corpus the KL metric is measured on, which must NOT be the one above:
# that is what EXL3 calibrates against, so measuring there is measuring on the
# training set. Baked rather than downloaded at run time so a paid pod cannot
# lose a job to a dataset outage.
COPY docker/fetch_kl_corpus.py /tmp/fetch_kl_corpus.py
RUN mkdir -p /opt/blockquant \
    && python /tmp/fetch_kl_corpus.py /opt/blockquant/kl_eval_corpus.utf8 \
    && rm /tmp/fetch_kl_corpus.py

# ---- Verify the stack at build time ---------------------------------------
RUN python - <<'PY'
import sys, torch, importlib.metadata as m
assert sys.version_info[:2] == (3, 12), f"need python 3.12, got {sys.version}"
assert torch.__version__.startswith("2.8"), f"torch not 2.8: {torch.__version__}"
assert m.version("exllamav3").startswith("1.4"), f"exllamav3 not 1.4.x: {m.version('exllamav3')}"
print("python", sys.version.split()[0], "| torch", torch.__version__,
      "| triton", m.version("triton"), "| fla", m.version("flash-linear-attention"),
      "| exllamav3", m.version("exllamav3"), "| transformers", m.version("transformers"))
PY
# `import fla` parses triton kernels (CPU) then inits the CUDA driver. On the
# GPU-less builder it must REACH the driver init -- proving the #5224 parse bug
# is gone under py3.12. The driver error is expected here (satisfied on the pod);
# the parse AttributeError (the py3.11 failure) would fail the build instead.
RUN python - <<'PY'
try:
    import fla
    print("FLA IMPORT OK (gpu driver present)")
except RuntimeError as e:
    assert "driver" in str(e).lower(), f"unexpected fla import error: {e!r}"
    print("FLA parse OK; reached GPU driver init (expected GPU-less on CI):", e)
PY
# exllamav3's CUDA ext JITs on import (ninja present) -> best-effort GPU-less.
RUN python -c "import exllamav3; print('exllamav3 import ok')"

# ---- BlockQuant remote entrypoint ----------------------------------------
RUN mkdir -p /opt/blockquant
COPY backend/src/blockquant/remote/quant.py /opt/blockquant/quant.py
COPY backend/src/blockquant/cards.py /opt/blockquant/cards.py
COPY backend/templates/card_template.md /opt/blockquant/card_template.md
COPY docker/entrypoint.sh /opt/blockquant/entrypoint.sh
RUN chmod +x /opt/blockquant/entrypoint.sh /opt/blockquant/quant.py

# ---- Vendored self-calibration scripts -----------------------------------
# turboderp's sc_*.py live at the root of the exllamav3 repo and are not part of
# the wheel, so the installed exllamav3 above does not carry them. Copied in at
# the same ref the wheel is pinned to (they import exllamav3.modules internals);
# backend/tests/test_selfcal_vendor.py fails if the two drift apart.
#
# Nothing in the pipeline calls these yet. They are here so a pod that already
# has the model on disk can run a sensitivity measurement without a second image.
# No new pip deps: sc_measure wants datasets, sc_trace wants safetensors, both
# are installed above; sc_optimize is stdlib only.
COPY backend/src/blockquant/selfcal /opt/blockquant/selfcal
RUN python -m compileall -q /opt/blockquant/selfcal

# ---- Image metadata ------------------------------------------------------
LABEL org.opencontainers.image.title="BlockQuant RunPod" \
      org.opencontainers.image.description="Pre-baked ExLlamaV3 quantization environment for RunPod pods." \
      org.opencontainers.image.source="https://github.com/Honkware/blockquant" \
      org.opencontainers.image.licenses="MIT" \
      blockquant.exllamav3_ref="${EXLLAMAV3_REF}" \
      blockquant.python_version="3.12" \
      blockquant.torch_version="2.8.0+cu129" \
      blockquant.cuda_runtime="12.9.1"

# ---- Default workdir + ports ---------------------------------------------
WORKDIR /workspace
EXPOSE 22

# Keep the pod alive — RunPod handles SSH key injection via env[PUBLIC_KEY]
# and starts its own sshd. Our entrypoint just sets up the public key (if
# present) and then sleeps forever; the local provider SSHes in to drive
# the quant.
CMD ["/opt/blockquant/entrypoint.sh"]
