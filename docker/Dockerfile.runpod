# BlockQuant pre-baked RunPod image.
#
# Bakes every gotcha we discovered the hard way so that a RunPod pod is
# "quant-ready" the instant it boots — no apt-get, no pip during the run.
#
# One image for every architecture. exllamav3 1.6.5 covers every registered
# archs from a single build: the linear-attention family (qwen3_5, qwen3_next,
# nemotronh) needs flash-linear-attention, which is installed here, and nothing
# else needs a separate bake. The old three-image split (stable 0.0.38 +
# qwen35 0.0.43 + a master image for LFM2) is gone.
#
# **Python 3.12** is load-bearing. fla's triton kernels trip triton bug #5224
# (multi-decorator @triton.jit -> inspect.getsource returns only the decorators
# -> `import fla` AttributeError) on Python 3.11 but not on 3.12. So
# ubuntu24.04 (native py3.12), torch 2.8/cu129, triton at its native 3.4.0.
#
# flash-attn is NOT installed and is no longer needed: exllamav3 ships
# Triton attention kernels that lead the dispatch order and handle sliding
# window, so Gemma3/Gemma4/Mellum no longer depend on a prebuilt FA2 wheel.
#
# Built and pushed by .github/workflows/build-runpod-image.yml.
#
# Two stages. Everything is installed and the CUDA extension compiled on the
# devel image, then the Python packages are copied onto CUDA's base image. The
# single-stage build was 11.3 GB compressed, 6.3 GB of it the devel image's
# toolkit, runtime libraries and cuDNN, none of which a pod uses: torch ships
# its own CUDA libraries. A community RTX 3090 never got it started in 15
# minutes where a Docker Hub image was up in 21 s.

# ---- Build stage (ubuntu24.04 -> Python 3.12) -----------------------------
FROM nvidia/cuda:12.9.1-devel-ubuntu24.04 AS build

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1

RUN apt-get update && apt-get install -y --no-install-recommends \
        python3.12 python3.12-dev python3-pip \
        git wget ca-certificates \
        ninja-build build-essential \
        openssh-server \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /var/run/sshd \
    && update-alternatives --install /usr/bin/python python /usr/bin/python3.12 1 \
    && update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.12 1 \
    && rm -f /usr/lib/python3.12/EXTERNALLY-MANAGED

# ---- torch 2.8 / cu129 (pip auto-selects the cp312 wheel) ------------------
RUN python -m pip install \
        "torch==2.8.0" \
        --index-url https://download.pytorch.org/whl/cu129

# ---- Python deps ----------------------------------------------------------
# hf_transfer gives parallel, Rust-backed weight downloads (the 70GB+ pull is
# the longest part of a run); remote/quant.py turns it on when it is present.
RUN python -m pip install \
        "setuptools>=77" "wheel" "ninja" \
        "hf_transfer>=0.1.6" \
        "huggingface-hub>=0.21" \
        "transformers>=4.56.0,<5" \
        "accelerate>=0.34" \
        "tokenizers>=0.21.1" \
        "safetensors>=0.4" \
        "datasets>=2.0" \
        "numpy>=2.1.0" \
        "Pillow>=10.0" \
        "marisa-trie>=1.2" \
        "pydantic==2.11.0" \
        "rich>=13.0" \
        "tqdm" \
        "psutil" \
        "sentencepiece" \
        "pyyaml" \
        "typing_extensions" \
        "einops"

# ---- ExLlamaV3 ------------------------------------------------------------
# Pinned to a git ref, not a PyPI release, so the image carries architectures
# merged upstream but not yet released. --no-deps stops pip resolving torch and
# fla again; both are installed explicitly here.
#
# --no-build-isolation is what makes the extension precompile. exllamav3's
# build requirements do not list torch, so an isolated build cannot import it,
# setup.py prints "Cannot precompile unless torch is installed", and the
# package installs without exllamav3_ext. The old image got away with that:
# its import check JIT-built the extension into torch_extensions, and the
# toolkit was still there for torch's loader at run time. Precompiled, the pod
# needs no toolkit, which is what lets the runtime stage drop it.
# _get_cuda_arch_flags reads TORCH_CUDA_ARCH_LIST before it looks for a
# device, so a GPU-less CI builder compiles for the arches named.
#
# Arches cover everything the GPU selector can pick at >=24 GB: A100 (8.0),
# A40/A5000/3090 (8.6), L40S/4090/6000-Ada (8.9), H100 (9.0), 5090 and
# RTX PRO 6000 Blackwell (12.0). +PTX leaves a JIT path for anything newer.
ENV TORCH_CUDA_ARCH_LIST="8.0;8.6;8.9;9.0;12.0+PTX"
ARG MAX_JOBS=2
ENV MAX_JOBS=${MAX_JOBS}
# Bump EXLLAMAV3_REF behind an end-to-end validation pass. The controller's
# health check enforces a minimum reported version (_MIN_EXLLAMAV3 in
# providers/runpod/provider.py); this ref reports 1.6.5.
#
# v1.6.5. Pinned to the tag's commit rather than the tag name, since a tag can
# be moved.
#
# 1.5.0 -> 1.6.5 is 469 commits. What matters here: new archs (bailing_hybrid
# for Ling 3.x, kimi_linear, mimo_v2, lfm2_vl, dflash2, gemma4_assistant);
# convert takes -mb/-ngb/-eb and a level for -hq; it splits a large MoE layer
# into several capture passes when its Hessians do not fit in VRAM; and
# sc_trace packs one calibration row per trace row from position 0 rather than
# slicing a concatenated stream, because a window cut mid-conversation made
# Gemma4-it unstable. That last one changes what an SC quant comes out as.
# sc_measure's layer streaming is upstream now, so selfcal/ carries one local
# patch instead of two.
#
# 1.4.9 -> 1.5.0 replaces the single-token and batched MoE paths with one
# two-stage cooperative kernel and makes MoE output deterministic, and swaps in
# new quantizer kernels chosen per group size and arch (with an accuracy fix at
# K=2). Both change what a quant comes out as, which is why _MIN_EXLLAMAV3 moved
# with it -- rolling back past this should not be quiet.
#
# Vision, carried over from the 1.4.2 -> 1.4.9 bump: --vision_bits used to
# default to 16 (tower copied unquantized) and now defaults to auto, so a tower
# the arch declares validated goes to 6 bpw and every other tower stays at 16.
# Qwen3-VL, Gemma4, GLM4V, Step3, DeepSeek-V4-Vision and MuseGlimmer are the
# validated ones. The vision_bits option on the command is what makes that
# choice visible and reversible.
ARG EXLLAMAV3_REF=cdc785db89e263e65e5849cb53e1ada156411414
RUN python -m pip install --no-cache-dir --no-deps --no-build-isolation \
        "exllamav3 @ git+https://github.com/turboderp-org/exllamav3@${EXLLAMAV3_REF}" \
    && python -c "import importlib.util as u; assert u.find_spec('exllamav3_ext'), 'exllamav3_ext was not precompiled'"

# ---- flash-linear-attention (linear-attention archs) ----------------------
# exllamav3 lists it in install_requires; the gated-delta-net path uses its
# chunked kernel for prefill and falls back to a much slower built-in recurrent
# kernel without it, and nemotronh/mamba2 import it outright.
RUN python -m pip install --no-cache-dir "flash-linear-attention>=0.5.0"

# ---- Bundled calibration corpus ------------------------------------------
# exllamav3's packaging still omits conversion/standard_cal_data/*.utf8 (not in
# package_data, not in MANIFEST.in), which convert_model needs. Fetch it into
# the installed package.
COPY docker/fetch_cal_data.py /tmp/fetch_cal_data.py
RUN python /tmp/fetch_cal_data.py && rm /tmp/fetch_cal_data.py

# The corpus the KL metric is measured on: wikitext-2 test, which is what
# qbench's own example project uses and the only set sc_measure implements.
# It must not be what EXL3 calibrates against -- measuring there is measuring
# on the training set. It is not: that is standard_cal_data/wiki.utf8, a
# general Wikipedia dump, and 393 sampled 12-word shingles from this test split
# appear in it zero times.
#
# Warmed into the image's dataset cache rather than downloaded per job, so a
# paid pod cannot lose its number to a Hugging Face outage. qbench's loader
# then finds it offline.
ENV HF_DATASETS_CACHE=/opt/blockquant/datasets
RUN mkdir -p /opt/blockquant/datasets \
    && python -c "from datasets import load_dataset; \
                  d=load_dataset('Salesforce/wikitext','wikitext-2-raw-v1',split='test'); \
                  print('wikitext-2 test rows:', len(d))"

# ---- Runtime stage --------------------------------------------------------
# CUDA's base image: the driver hooks and a cudart, no toolkit. gcc and the
# Python headers stay, because Triton compiles a small launcher stub for the
# fla kernels the first time they run. pip and procps because the provider
# tops up hf_transfer and checks for a running job with pgrep.
FROM nvidia/cuda:12.9.1-base-ubuntu24.04

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    HF_DATASETS_CACHE=/opt/blockquant/datasets

RUN apt-get update && apt-get install -y --no-install-recommends \
        python3.12 python3.12-dev python3-pip \
        gcc libc6-dev git wget ca-certificates procps \
        openssh-server \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /var/run/sshd \
    && update-alternatives --install /usr/bin/python python /usr/bin/python3.12 1 \
    && update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.12 1 \
    && rm -f /usr/lib/python3.12/EXTERNALLY-MANAGED

# System Python, not a venv: the provider drives the pod over SSH, and a login
# shell there does not see this image's ENV PATH.
COPY --from=build /usr/local/lib/python3.12/dist-packages /usr/local/lib/python3.12/dist-packages
COPY --from=build /usr/local/bin /usr/local/bin
COPY --from=build /opt/blockquant/datasets /opt/blockquant/datasets

# ---- Verify the stack at build time ---------------------------------------
RUN python - <<'PY'
import sys, torch, importlib.metadata as m
assert sys.version_info[:2] == (3, 12), f"need python 3.12, got {sys.version}"
assert torch.__version__.startswith("2.8"), f"torch not 2.8: {torch.__version__}"
_exl = tuple(int(x) for x in m.version("exllamav3").split(".")[:2])
assert _exl >= (1, 6), f"exllamav3 older than 1.6: {m.version('exllamav3')}"
print("python", sys.version.split()[0], "| torch", torch.__version__,
      "| triton", m.version("triton"), "| fla", m.version("flash-linear-attention"),
      "| exllamav3", m.version("exllamav3"), "| transformers", m.version("transformers"))
PY
# `import fla` parses triton kernels (CPU) then inits the CUDA driver. On the
# GPU-less builder it must REACH the driver init -- proving the #5224 parse bug
# is gone under py3.12. The driver error is expected here (satisfied on the pod);
# the parse AttributeError (the py3.11 failure) would fail the build instead.
RUN python - <<'PY'
try:
    import fla
    print("FLA IMPORT OK (gpu driver present)")
except RuntimeError as e:
    assert "driver" in str(e).lower(), f"unexpected fla import error: {e!r}"
    print("FLA parse OK; reached GPU driver init (expected GPU-less on CI):", e)
PY
# The extension has to be the precompiled one: there is no toolkit here to
# JIT it with, so a missing exllamav3_ext would only show up on a paid pod.
RUN python -c "import importlib.util as u; assert u.find_spec('exllamav3_ext'), 'no precompiled exllamav3_ext'; \
               import exllamav3; print('exllamav3 import ok')"

# ---- BlockQuant remote entrypoint ----------------------------------------
RUN mkdir -p /opt/blockquant
COPY backend/src/blockquant/remote/quant.py /opt/blockquant/quant.py
COPY backend/src/blockquant/cards.py /opt/blockquant/cards.py
COPY backend/templates/card_template.md /opt/blockquant/card_template.md
COPY docker/entrypoint.sh /opt/blockquant/entrypoint.sh
RUN chmod +x /opt/blockquant/entrypoint.sh /opt/blockquant/quant.py

# ---- Vendored self-calibration scripts -----------------------------------
# turboderp's sc_*.py live at the root of the exllamav3 repo and are not part of
# the wheel, so the installed exllamav3 above does not carry them. Copied in at
# the same ref the wheel is pinned to (they import exllamav3.modules internals);
# backend/tests/test_selfcal_vendor.py fails if the two drift apart.
#
# Nothing in the pipeline calls these yet. They are here so a pod that already
# has the model on disk can run a sensitivity measurement without a second image.
# No new pip deps: sc_measure wants datasets, sc_trace wants safetensors, both
# are installed above; sc_optimize is stdlib only.
COPY backend/src/blockquant/selfcal /opt/blockquant/selfcal
RUN python -m compileall -q /opt/blockquant/selfcal

# ---- Image metadata ------------------------------------------------------
LABEL org.opencontainers.image.title="BlockQuant RunPod" \
      org.opencontainers.image.description="Pre-baked ExLlamaV3 quantization environment for RunPod pods." \
      org.opencontainers.image.source="https://github.com/Honkware/blockquant" \
      org.opencontainers.image.licenses="MIT" \
      blockquant.exllamav3_ref="${EXLLAMAV3_REF}" \
      blockquant.python_version="3.12" \
      blockquant.torch_version="2.8.0+cu129" \
      blockquant.cuda_runtime="12.9.1"

# ---- Default workdir + ports ---------------------------------------------
WORKDIR /workspace
EXPOSE 22

# Keep the pod alive — RunPod handles SSH key injection via env[PUBLIC_KEY]
# and starts its own sshd. Our entrypoint just sets up the public key (if
# present) and then sleeps forever; the local provider SSHes in to drive
# the quant.
CMD ["/opt/blockquant/entrypoint.sh"]
